{
  "datasets": [
    {
      "name": "24716743",
      "displayName": "fact_transactions_denorm",
      "config": {
        "version": "1.1",
        "source": "ecommerce.gold.fact_transactions_denorm",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "9619ae52",
      "displayName": "Monthly Ecommerce Sales Summary",
      "queryLines": [
        "SELECT\r\n",
        "    DATE_TRUNC('MONTH', transaction_date) AS month,\r\n",
        "    ROUND(SUM(net_amount), 2) AS net_amount\r\n",
        "FROM ecommerce.gold.gld_fact_order_items\r\n",
        "GROUP BY DATE_TRUNC('MONTH', transaction_date)\r\n",
        "ORDER BY month;\r\n"
      ]
    },
    {
      "name": "acfdff9c",
      "displayName": "Category Revenue Summary Analysis",
      "queryLines": [
        "SELECT\r\n",
        "  category_name,\r\n",
        "  ROUND(SUM(net_amount), 2) AS net_amount\r\n",
        "FROM\r\n",
        "  ecommerce.gold.fact_transactions_denorm\r\n",
        "GROUP BY\r\n",
        "  category_name\r\n",
        "ORDER BY\r\n",
        "  net_amount DESC;"
      ]
    },
    {
      "name": "474543f6",
      "displayName": "Weekly Hourly Sales Summary Dataset",
      "queryLines": [
        "SELECT\r\n",
        "  day_name,\r\n",
        "  hour_of_day,\r\n",
        "  ROUND(SUM(net_amount), 2) AS net_amount\r\n",
        "FROM\r\n",
        "  ecommerce.gold.fact_transactions_denorm\r\n",
        "WHERE\r\n",
        "  transaction_ts IS NOT NULL\r\n",
        "GROUP BY\r\n",
        "  day_name,\r\n",
        "  hour_of_day\r\n",
        "ORDER BY\r\n",
        "  CASE day_name\r\n",
        "    WHEN 'Sunday' THEN 1\r\n",
        "    WHEN 'Monday' THEN 2\r\n",
        "    WHEN 'Tuesday' THEN 3\r\n",
        "    WHEN 'Wednesday' THEN 4\r\n",
        "    WHEN 'Thursday' THEN 5\r\n",
        "    WHEN 'Friday' THEN 6\r\n",
        "    WHEN 'Saturday' THEN 7\r\n",
        "  END,\r\n",
        "  hour_of_day;"
      ]
    }
  ],
